# Copy this file to .env and fill in real values. NEVER commit an actual .env file.

PORT=8080

# MySQL/XAMPP connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shopdb
DB_CONNECTION_LIMIT=10

# Must be a long, random string in real deployments — never reuse this sample value.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=24h

# Where the frontend is served from (Express serves it too by default on the same port,
# so this only matters if you run the frontend separately, e.g. via Live Server).
CORS_ORIGIN=http://localhost:5500

